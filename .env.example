# =============================================================================
# fresh-platform — environment template
# Copy to .env and fill in values. NEVER commit .env.
# =============================================================================

# --- Brand (single-tenant for now) ---
BRAND_NAME=Fresh Platform
SUPPORT_EMAIL=support@example.com

# --- ERPNext (system of record) ---
# Get these from your Frappe Cloud site or self-hosted ERPNext instance.
# See docs/erpnext-setup.md for how to generate API key + secret.
ERPNEXT_URL=https://your-site.frappe.cloud
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# --- Postgres (commerce-api owns) ---
DATABASE_URL=postgres://commerce:commerce@localhost:5432/commerce

# --- Redis (cart + cache) ---
REDIS_URL=redis://localhost:6379

# --- GCP Pub/Sub ---
# Local dev uses the emulator started by docker-compose.
PUBSUB_PROJECT_ID=fresh-platform-local
PUBSUB_EMULATOR_HOST=localhost:8085
# In production, leave PUBSUB_EMULATOR_HOST empty and use a real GCP project id.

# --- Auth ---
# 32+ random chars. Generate with: openssl rand -base64 48
JWT_SECRET=replace_me_with_a_long_random_string
JWT_ISSUER=fresh-platform
JWT_AUDIENCE=fresh-platform-storefront
JWT_TTL_SECONDS=2592000

# --- M-Pesa (Daraja) ---
# Sandbox credentials from https://developer.safaricom.co.ke
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://localhost:8080/webhooks/mpesa

# --- Server ---
PORT=8080
LOG_LEVEL=info
NODE_ENV=development
